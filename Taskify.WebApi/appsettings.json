{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=<POSTGRES_DB>;Username=<POSTGRES_USERNAME>;Password=<POSTGRES_PASSWORD>"
  },
  "JsonWebTokenOptions": {
    "Issuer": "https://localhost:5001",
    "Audience": "https://localhost:5001",
    "SecretKey": "super-secret-key-at-least-32-characters-long!!",
    "Expiration": "00:15:00"
  },
  "RefreshTokenOptions": {
    "Expiration": "7.00:00:00"
  },
  "ExternalProvidersOptions": {
    "Google": {
      "ClientId": "<GOOGLE_CLIENT_ID>",
      "ClientSecret": "<GOOGLE_CLIENT_SECRET>"
    }
  },
  "ItemExpirationOptions": {
    "CheckInterval": "00:05:00",
    "BatchSize": 1000
  },
  "SoftDeleteOptions": {
    "CheckInterval": "00:05:00",
    "RetentionPeriod": "00:15:00",
    "BatchSize": 1000
  }
}
